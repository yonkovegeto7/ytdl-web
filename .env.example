# Copy this file to .env (or paste the values in your hosting dashboard).
# Every variable is optional - the app runs without any of them.

# Port the server listens on. Most platforms inject this for you.
PORT=7860

# Where temporary downloads are written. /tmp is safe on every free host.
DOWNLOAD_DIR=/tmp/ytdl_downloads

# How many downloads can run at the same time.
# 512 MB instances: 1.  1 GB+: 2.  8 GB VPS: 8-10.
MAX_CONCURRENT=2

# How many visitors may wait in the queue at once. They are never rejected
# while the server is busy - they just see their position in the line.
# 0 = unlimited waiting line.
MAX_QUEUE=300

# Seconds a finished file stays downloadable. 0 = never delete by age
# (only when MAX_STORAGE_MB is reached, oldest first). Keep 0 if your visitors
# have slow connections and need a long time to download.
FILE_TTL=0

# Hard cap for stored downloads in MB. 0 = no cap.
# 20000 = 20 GB. Oldest files are deleted first when the cap is hit.
MAX_STORAGE_MB=20000

# Refuse videos taller than this (0 = no limit). 1080 is a good cap for free hosts.
MAX_HEIGHT=0

# Refuse videos longer than this in seconds (0 = no limit). 3600 = 1 hour.
MAX_DURATION=0

# Abuse protection: requests allowed per client IP per hour.
RATE_FETCH=120
RATE_DOWNLOAD=60

# ---------------------------------------------------------------------------
# YouTube blocks most datacenter IPs with "Sign in to confirm you're not a bot".
# If that happens, export cookies from a logged-in browser as Netscape format
# and base64-encode the file:
#   Windows:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt")) > cookies.b64
#   Linux:    base64 -w0 cookies.txt > cookies.b64
# then put the output on one line here.
# WARNING: cookies are full account access - use a throwaway Google account.
# ---------------------------------------------------------------------------
COOKIES_B64=

# Or point to a cookies.txt file that already exists inside the container.
# COOKIES_FILE=/app/cookies.txt

# Route yt-dlp through a proxy (residential proxies work best against YouTube).
# YTDLP_PROXY=http://user:pass@host:port

# Impersonate a real browser (needs the curl_cffi extra, included by yt-dlp[default]).
YTDLP_IMPERSONATE=chrome

# Extra yt-dlp extractor arguments. Try this if formats are missing:
# YTDLP_EXTRACTOR_ARGS=youtube:player_client=web_safari
